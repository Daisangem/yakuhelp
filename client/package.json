{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k --kill-signal SIGINT -n CLIENT,SERVER -c blue,green \"vite\" \"dotnet run --project ../server\"",
    "dev:client": "vite",
    "build": "tsc && vite build && dotnet build ../server",
    "build:client": "tsc && vite build",
    "build:server": "dotnet build ../server",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "htmx.org": "^2.0.11",
    "typescript-language-server": "^6.1.0"
  }
}
