gitignore
# Client (Vite / pnpm)
client/node_modules/
client/dist/
client/.vite/
client/coverage/

# Environment files
client/.env
client/.env.*
!client/.env.example

# Server (.NET / Razor)
server/bin/**
server/bin/Debug/net11.0
server/obj/
server/out/
server/wwwroot/

# Visual Studio / Rider
server/.vs/
server/.idea/
server/**/*.user
server/**/*.suo

# .NET generated files
server/**/*.cache
server/**/*.log
server/**/packages/
server/**/*.nupkg


# Environment / secrets
server/**/appsettings.Development.json
server/**/secrets.json

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
